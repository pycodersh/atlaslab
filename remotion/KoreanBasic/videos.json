  "formal-vs-casual-korean-when-to-drop-yo": {
    "audio": "audio/korean-basic/formal-vs-casual-korean-when-to-drop-yo.mp3",
    "hook": {
      "cue": { "label": "Politeness lives in", "word": "the ending" },
      "cards": [{ "ko": "먹어", "rom": "to someone older" }, { "ko": "좋아요 → 좋아", "rom": "switching mid-chat" }],
      "caption": "⚠️ Dropping 요 too soon"
    },
    "contrast": {
      "heading": "Every sentence picks a level",
      "cards": [
        { "ko": "먹어요", "rom": "meogeoyo", "tone": "green", "lines": ["**요 form**: your default", "Strangers, staff, anyone older"] },
        { "ko": "먹어", "rom": "meogeo", "tone": "red", "lines": ["**반말**: casual", "Close friends your age, children"] }
      ],
      "banner": { "text": "Dropping 요 is a statement about the relationship", "tone": "navy" }
    },
    "takeaway": {
      "title": "Stay on the safe side",
      "cards": [
        { "title": "Default", "ex": "가요 · 먹어요", "exRom": "Polite, never rude" },
        { "title": "You’ll hear", "ex": "갑니다", "exRom": "Formal, from staff" },
        { "title": "Ask first", "ex": "말 놓아도 될까요?", "exRom": "Can we speak casually?" }
      ],
      "slogan": "Wait to be invited before dropping 요 ✅"
    },
    "narration": [
      [0, "In Korean, every sentence picks a politeness level."],
      [4, "Yo keeps it polite. Drop it, and you're speaking casually."],
      [8, "Default to yo, until someone invites you to drop it."]
    ]
  },

  "why-korean-has-two-number-systems": {
    "audio": "audio/korean-basic/why-korean-has-two-number-systems.mp3",
    "hook": {
      "cue": { "label": "English:", "word": "ONE · TWO · THREE" },
      "cards": [{ "ko": "하나 개", "rom": "hana gae" }, { "ko": "삼십 천 원", "rom": "samsip cheon won" }],
      "caption": "⚠️ Two number traps"
    },
    "contrast": {
      "heading": "Which set of numbers?",
      "cards": [
        { "ko": "하나 둘 셋", "rom": "hana dul set", "tone": "navy", "lines": ["**Native**: things you count", "맥주 두 병 · two beers"] },
        { "ko": "일 이 삼", "rom": "il i sam", "tone": "green", "lines": ["**Sino-Korean**: figures", "삼만 원 · 30,000 won"] }
      ],
      "banner": { "text": "Money counts in 만 (10,000)", "tone": "navy" }
    },
    "takeaway": {
      "title": "Say it today",
      "cards": [
        { "title": "Two beers", "ex": "맥주 두 병", "exRom": "two bottles of beer" },
        { "title": "3:30", "ex": "세 시 삼십 분", "exRom": "native hour, Sino minutes" },
        { "title": "The price", "ex": "삼만 원", "exRom": "30,000 won" }
      ],
      "slogan": "Count it? Native. Read it? Sino-Korean ✅"
    },
    "narration": [
      [0, "Korean has two sets of numbers, and you need both."],
      [4, "Native numbers count things. Sino-Korean reads money and dates."],
      [8, "Time mixes them: seh-shee sahm-ship-boon is three thirty."]
    ]
  },

  "eun-neun-vs-i-ga-difference": {
    "audio": "audio/korean-basic/eun-neun-vs-i-ga-difference.mp3",
    "hook": {
      "cue": { "label": "Who came?", "word": "누가 왔어요?" },
      "cards": [{ "ko": "에마는 왔어요", "rom": "as the answer" }, { "ko": "김치는 좋아해요", "rom": "no contrast meant" }],
      "caption": "⚠️ 은/는 hints at more than you mean"
    },
    "contrast": {
      "heading": "Pointing, or setting the frame?",
      "cards": [
        { "ko": "이/가", "rom": "i/ga", "tone": "navy", "lines": ["**Points at** new information", "에마가 왔어요 · Emma came"] },
        { "ko": "은/는", "rom": "eun/neun", "tone": "green", "lines": ["**Sets the frame**, or a contrast", "에마는 공부해요 · Emma studies"] }
      ],
      "banner": { "text": "Answering “who?” → 이/가", "tone": "navy" }
    },
    "takeaway": {
      "title": "Hear it in context",
      "cards": [
        { "title": "First mention", "ex": "친구가 왔어요", "exRom": "A friend came." },
        { "title": "Now known", "ex": "그 친구는 미국 사람이에요", "exRom": "That friend is American." },
        { "title": "Contrast", "ex": "저는 커피 좋아해요", "exRom": "I like coffee (others may not)." }
      ],
      "slogan": "Notice them in phrases, don’t drill them ✅"
    },
    "narration": [
      [0, "Who came? Answer with ee-ga, not eun-neun."],
      [4, "Ee-ga points at something new. Eun-neun sets the frame."],
      [8, "Notice them in real sentences, instead of drilling rules."]
    ]
  },

  "is-korean-hard-to-learn-for-english-speakers": {
    "audio": "audio/korean-basic/is-korean-hard-to-learn-for-english-speakers.mp3",
    "hook": {
      "cue": { "label": "Is Korean hard?", "word": "Parts of it." },
