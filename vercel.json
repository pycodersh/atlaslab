{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.atlaslabstudios.com" }],
      "destination": "https://atlaslabstudios.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/daily",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "app/api/essays/review/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
