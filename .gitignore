# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local audio downloads (not committed)
/tmp-audio/

# Webtoon canvas export outputs (intermediate files, not committed)
/data/kpatto/exports/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
data/library/exports/

# generated audio files — served from Supabase Storage, not from public/
public/audio-generated/
public/audio/*.mp3
public/audio/*.wav

# voice comparison / validation — dev-only, not used in production app
public/voice-comparison/
public/voice-validation/

# other large generated assets
public/videos/*.mp4
public/videos/*.mov

# videos sub-project — node_modules and build cache excluded
videos/patto-animations/node_modules/
videos/patto-animations/.next/

# Claude Code local settings (may contain approved command history)
.claude/settings.local.json

# session backups and logs — local only, not for version control
data/backup/
export.log

# large DB backup dumps - local only
data/kpatto/source/backup/

# audio progress / failure tracking - local only
scripts/audio-*.json

# 표현 음성 시험 파일 (로컬 비교용, 커밋하지 않음)
/audio-test/openai/
/audio-test/openai4o/
/audio-test/zephyr/
/audio-test/zephyr-expr/
/audio-test/probe/
/audio-test/expr-data.json

# 표현 음성 덮어쓰기 전 백업 (Gemini Zephyr판)
/audio-backup/
/scripts/expr-audio-report*.json
/scripts/expr-audio-verify.json
/audio-test/preq-expr/
/scripts/question-pattern-report.json
/scripts/gemini-strict-abort.json
/audio-test/noq-expr/
/scripts/gemini-other-skipped.json
/reels-audio/
/out/
/reels-audio/*/_raw/
